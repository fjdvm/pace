generator client {
  provider = "prisma-client"
  output   = "../../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String         @id
  email              String         @unique
  name               String?
  isAdmin            Boolean        @default(false) @map("is_admin")
  createdAt          DateTime       @default(now()) @map("created_at")
  classes            Class[]
  enrollments        Enrollment[]
  createdAssignments Assignment[]
  heartsStates       HeartsState[]
  submissions        Submission[]
  submissionRevisions SubmissionRevision[]
  chatMessages       ChatMessage[]
  xpEvents           XpEvent[]
  userBadges         UserBadge[]
  streak             Streak?
  codeDrafts         CodeDraft[]
  notifications      Notification[]
  posts              Post[]
  comments           Comment[]

  @@map("users")
}

model Class {
  id              String            @id @default(uuid())
  name            String
  instructorId    String            @map("instructor_id")
  joinCode        String            @unique @map("join_code")
  aiProvider      String?           @map("ai_provider")
  aiApiKeyEnc     String?           @map("ai_api_key_enc")
  leaderboardSize Int               @default(10) @map("leaderboard_size")
  archived        Boolean           @default(false)
  createdAt       DateTime          @default(now()) @map("created_at")
  instructor      User              @relation(fields: [instructorId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]
  assignments     AssignmentClass[]
  posts           Post[]

  @@map("classes")
}

model Enrollment {
  studentId  String   @map("student_id")
  classId    String   @map("class_id")
  archived   Boolean  @default(false)
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  student    User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@id([studentId, classId])
  @@map("enrollments")
}
